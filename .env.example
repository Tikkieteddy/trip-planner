# Google Maps Platform (browser key: HTTP-referrer restricted; server key: server only)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_KEY=

# Auth0 (@auth0/nextjs-auth0 v4). Required: domain, client id, client secret, secret.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Optional: inferred from the request host when unset
APP_BASE_URL=

# Upstash Redis REST (Cloud Sync + Ads config). KV_* are legacy aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# CMS admin (password >= 10 chars, session secret >= 32 chars)
ADS_ADMIN_PASSWORD=
ADS_ADMIN_SESSION_SECRET=
AD_SCRIPT_HTML=
AD_SCRIPT_HTML_MOBILE=
AD_SCRIPT_HTML_DESKTOP=

# Legacy Clerk route migration only (optional; remove after migration is confirmed)
CLERK_SECRET_KEY=
